# Copy to .env and fill in (openssl rand -hex 32). .env is gitignored.
UMAMI_DB_PASSWORD=change-me
UMAMI_APP_SECRET=change-me-64-hex-chars
UMAMI_2FA_KEY=change-me-64-hex-chars
# Optional: track the analyzer too (see overrides/build-corescope-index.sh). Leave empty to skip.
UMAMI_MAP_WEBSITE_ID=
UMAMI_TRACKER_URL=https://example.org/u
UMAMI_MAP_DOMAIN=map.example.org
